
def_module_params('solver', 
                  description='solver parameters',
                  export=True,
                  params=(('smtlib2_log', SYMBOL, '', "file to save solver interaction"),
                          ('cancel_backup_file', SYMBOL, '', "file to save partial search state if search is canceled"),
                          ('timeout', UINT, UINT_MAX, "timeout on the solver object; overwrites a global timeout"),
                          ('lemmas2console', BOOL, False, 'print lemmas during search'),
                          ('instantiations2console', BOOL, False, 'print quantifier instantiations to the console'),
                          ('axioms2files', BOOL, False, 'print negated theory axioms to separate files during search'),
                          ('slice', BOOL, False, 'use slice solver that filters assertions to use symbols occuring in @query formulas'),
                          ('proof.log', SYMBOL, '', 'log clause proof trail into a file'),
                          ('proof.check', BOOL, True, 'check proof logs'),
                          ('proof.check_rup', BOOL, True, 'check proof RUP inference in proof logs'),
                          ('proof.save', BOOL, False, 'save proof log into a proof object that can be extracted using (get-proof)'),
                          ('proof.trim', BOOL, False, 'trim and save proof into a proof object that an be extracted using (get-proof)'),
                          ('proof.replay', BOOL, False, 'replay proof after trimming'),
                          ('proof.interpolate', BOOL, False, 'compute A/B clause and variable markings during proof trimming for interpolation'),
                          ('proof.interpolate_log', BOOL, False, 'when logging a clause proof, emit A/B (__itp_A/__itp_B) markings on input clauses according to their (set-itp-group ...) partition'),
                          ('proof.check_interpolant', BOOL, False, 'after computing an interpolant during proof replay, verify that A implies it, that it is inconsistent with B, and that it only uses shared symbols'),
                          ('proof.core_first_bcp', BOOL, False, 'during proof replay, prefer propagating clauses already marked as core before the remaining clauses'),
                          ('proof.reorder', BOOL, True, 'during interpolating proof replay, use colored (A-first) propagation and restructure RUP chains into per-partition stages (FMCAD14 DRUPing for Interpolants)'),
                          ('proof.itp_labeling', SYMBOL, 'mcmillan', 'labeling of shared variables for interpolation (labeled interpolation systems): mcmillan (strongest), hkp (symmetric), dual (weakest)'),
                          ('proof.check_labeling_order', BOOL, False, 'recompute the interpolant under all labelings on the same proof and check the strength order mcmillan => hkp => dual (advisory when theory lemmas are present)'),
                          ))
                
