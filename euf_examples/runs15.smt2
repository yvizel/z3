;; Two implication chains of 15 steps over independent equality atoms,
;; color pattern A A B repeating: consecutive A-steps form runs that proof
;; restructuring factors into single-colored chains. Purely propositional
;; (no EUF lemmas). Smaller sibling of itp_reorder.smt2.

(set-option :sat.euf true)
(set-option :tactic.default_tactic sat)
(set-option :solver.proof.log runs15_proof.smt2)
(set-option :solver.proof.interpolate_log true)

(declare-sort U)
(declare-const ea0 U)
(declare-const eb0 U)
(declare-const ea1 U)
(declare-const eb1 U)
(declare-const ea2 U)
(declare-const eb2 U)
(declare-const ea3 U)
(declare-const eb3 U)
(declare-const ea4 U)
(declare-const eb4 U)
(declare-const ea5 U)
(declare-const eb5 U)
(declare-const ea6 U)
(declare-const eb6 U)
(declare-const ea7 U)
(declare-const eb7 U)
(declare-const ea8 U)
(declare-const eb8 U)
(declare-const ea9 U)
(declare-const eb9 U)
(declare-const ea10 U)
(declare-const eb10 U)
(declare-const ea11 U)
(declare-const eb11 U)
(declare-const ea12 U)
(declare-const eb12 U)
(declare-const ea13 U)
(declare-const eb13 U)
(declare-const ea14 U)
(declare-const eb14 U)
(declare-const ea15 U)
(declare-const eb15 U)
(declare-const fa0 U)
(declare-const fb0 U)
(declare-const fa1 U)
(declare-const fb1 U)
(declare-const fa2 U)
(declare-const fb2 U)
(declare-const fa3 U)
(declare-const fb3 U)
(declare-const fa4 U)
(declare-const fb4 U)
(declare-const fa5 U)
(declare-const fb5 U)
(declare-const fa6 U)
(declare-const fb6 U)
(declare-const fa7 U)
(declare-const fb7 U)
(declare-const fa8 U)
(declare-const fb8 U)
(declare-const fa9 U)
(declare-const fb9 U)
(declare-const fa10 U)
(declare-const fb10 U)
(declare-const fa11 U)
(declare-const fb11 U)
(declare-const fa12 U)
(declare-const fb12 U)
(declare-const fa13 U)
(declare-const fb13 U)
(declare-const fa14 U)
(declare-const fb14 U)
(declare-const fa15 U)
(declare-const fb15 U)

(set-itp-group A)
(assert (and
          (or (= ea0 eb0) (= fa0 fb0))
          (or (not (= ea0 eb0)) (= ea1 eb1))
          (or (not (= ea2 eb2)) (= ea3 eb3))
          (or (not (= ea3 eb3)) (= ea4 eb4))
          (or (not (= ea5 eb5)) (= ea6 eb6))
          (or (not (= ea6 eb6)) (= ea7 eb7))
          (or (not (= ea8 eb8)) (= ea9 eb9))
          (or (not (= ea9 eb9)) (= ea10 eb10))
          (or (not (= ea11 eb11)) (= ea12 eb12))
          (or (not (= ea12 eb12)) (= ea13 eb13))
          (or (not (= ea14 eb14)) (= ea15 eb15))
          (or (not (= fa0 fb0)) (= fa1 fb1))
          (or (not (= fa2 fb2)) (= fa3 fb3))
          (or (not (= fa3 fb3)) (= fa4 fb4))
          (or (not (= fa5 fb5)) (= fa6 fb6))
          (or (not (= fa6 fb6)) (= fa7 fb7))
          (or (not (= fa8 fb8)) (= fa9 fb9))
          (or (not (= fa9 fb9)) (= fa10 fb10))
          (or (not (= fa11 fb11)) (= fa12 fb12))
          (or (not (= fa12 fb12)) (= fa13 fb13))
          (or (not (= fa14 fb14)) (= fa15 fb15))
        ))

(set-itp-group B)
(assert (and
          (or (not (= ea1 eb1)) (= ea2 eb2))
          (or (not (= ea4 eb4)) (= ea5 eb5))
          (or (not (= ea7 eb7)) (= ea8 eb8))
          (or (not (= ea10 eb10)) (= ea11 eb11))
          (or (not (= ea13 eb13)) (= ea14 eb14))
          (or (not (= fa1 fb1)) (= fa2 fb2))
          (or (not (= fa4 fb4)) (= fa5 fb5))
          (or (not (= fa7 fb7)) (= fa8 fb8))
          (or (not (= fa10 fb10)) (= fa11 fb11))
          (or (not (= fa13 fb13)) (= fa14 fb14))
          (not (= ea15 eb15))
          (not (= fa15 fb15))
        ))

(check-sat)
