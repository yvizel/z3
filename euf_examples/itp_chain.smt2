;; alternating A/B equality ladder: step i forces x_{i-1} = x_i either
;; directly or through the step-local y_i; odd steps are A, even steps B.
;; B additionally denies x_0 = x_N. Every RUP chain during replay mixes
;; colors, so proof reordering (solver.proof.reorder) has room to act.

(set-option :sat.euf true)
(set-option :tactic.default_tactic sat)
(set-option :solver.proof.log itp_chain_proof.smt2)
(set-option :solver.proof.interpolate_log true)

(declare-sort U)
(declare-const x0 U)
(declare-const x1 U)
(declare-const x2 U)
(declare-const x3 U)
(declare-const x4 U)
(declare-const x5 U)
(declare-const x6 U)
(declare-const x7 U)
(declare-const x8 U)
(declare-const x9 U)
(declare-const x10 U)
(declare-const x11 U)
(declare-const x12 U)
(declare-const y1 U)
(declare-const y2 U)
(declare-const y3 U)
(declare-const y4 U)
(declare-const y5 U)
(declare-const y6 U)
(declare-const y7 U)
(declare-const y8 U)
(declare-const y9 U)
(declare-const y10 U)
(declare-const y11 U)
(declare-const y12 U)

(set-itp-group A)
(assert (and
          (or (= x0 x1) (= x0 y1))
          (or (not (= x0 y1)) (= y1 x1))
          (or (= x2 x3) (= x2 y3))
          (or (not (= x2 y3)) (= y3 x3))
          (or (= x4 x5) (= x4 y5))
          (or (not (= x4 y5)) (= y5 x5))
          (or (= x6 x7) (= x6 y7))
          (or (not (= x6 y7)) (= y7 x7))
          (or (= x8 x9) (= x8 y9))
          (or (not (= x8 y9)) (= y9 x9))
          (or (= x10 x11) (= x10 y11))
          (or (not (= x10 y11)) (= y11 x11))
        ))

(set-itp-group B)
(assert (and
          (or (= x1 x2) (= x1 y2))
          (or (not (= x1 y2)) (= y2 x2))
          (or (= x3 x4) (= x3 y4))
          (or (not (= x3 y4)) (= y4 x4))
          (or (= x5 x6) (= x5 y6))
          (or (not (= x5 y6)) (= y6 x6))
          (or (= x7 x8) (= x7 y8))
          (or (not (= x7 y8)) (= y8 x8))
          (or (= x9 x10) (= x9 y10))
          (or (not (= x9 y10)) (= y10 x10))
          (or (= x11 x12) (= x11 y12))
          (or (not (= x11 y12)) (= y12 x12))
          (not (= x0 x12))
        ))

(check-sat)
