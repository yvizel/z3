;; Argument ladder x0 ~A x1 ~B x2 ~A x3 ~B x4 under an A-local F.
;; Boundary premise x1 = x4 plus the interior A-run x2 = x3.
;;   expected: (and (= x2 x3) (=> (= x1 x4) (= u v)))
(set-option :sat.euf true)
(set-option :tactic.default_tactic sat)
(set-option :solver.proof.log horn_alt_ladder_proof.smt2)
(set-option :solver.proof.interpolate_log true)
(declare-sort U)
(declare-const x0 U) (declare-const x1 U) (declare-const x2 U) (declare-const x3 U) (declare-const x4 U)
(declare-const u U) (declare-const v U)
(declare-fun F (U) U)
(set-itp-group A)
(assert (= u (F x0)))
(assert (= x0 x1))
(assert (= x2 x3))
(assert (= v (F x4)))
(set-itp-group B)
(assert (= x1 x2))
(assert (= x3 x4))
(assert (not (= u v)))
(check-sat)
