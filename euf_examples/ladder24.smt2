;; Alternating A/B equality ladder, 24 steps: step i forces x_(i-1) = x_i
;; either directly or through the step-local y_i (odd steps A, even B);
;; B denies x_0 = x_N. Theory (EUF transitivity/congruence) lemmas over
;; mixed A/B chains.
;;
;; Large instance: ~100-step trimmed proof with ~20 deletions.

(set-option :sat.euf true)
(set-option :tactic.default_tactic sat)
(set-option :solver.proof.log ladder24_proof.smt2)
(set-option :solver.proof.interpolate_log true)

(declare-sort U)
(declare-const x0 U)
(declare-const x1 U)
(declare-const x2 U)
(declare-const x3 U)
(declare-const x4 U)
(declare-const x5 U)
(declare-const x6 U)
(declare-const x7 U)
(declare-const x8 U)
(declare-const x9 U)
(declare-const x10 U)
(declare-const x11 U)
(declare-const x12 U)
(declare-const x13 U)
(declare-const x14 U)
(declare-const x15 U)
(declare-const x16 U)
(declare-const x17 U)
(declare-const x18 U)
(declare-const x19 U)
(declare-const x20 U)
(declare-const x21 U)
(declare-const x22 U)
(declare-const x23 U)
(declare-const x24 U)
(declare-const y1 U)
(declare-const y2 U)
(declare-const y3 U)
(declare-const y4 U)
(declare-const y5 U)
(declare-const y6 U)
(declare-const y7 U)
(declare-const y8 U)
(declare-const y9 U)
(declare-const y10 U)
(declare-const y11 U)
(declare-const y12 U)
(declare-const y13 U)
(declare-const y14 U)
(declare-const y15 U)
(declare-const y16 U)
(declare-const y17 U)
(declare-const y18 U)
(declare-const y19 U)
(declare-const y20 U)
(declare-const y21 U)
(declare-const y22 U)
(declare-const y23 U)
(declare-const y24 U)

(set-itp-group A)
(assert (and
          (or (= x0 x1) (= x0 y1))
          (or (not (= x0 y1)) (= y1 x1))
          (or (= x2 x3) (= x2 y3))
          (or (not (= x2 y3)) (= y3 x3))
          (or (= x4 x5) (= x4 y5))
          (or (not (= x4 y5)) (= y5 x5))
          (or (= x6 x7) (= x6 y7))
          (or (not (= x6 y7)) (= y7 x7))
          (or (= x8 x9) (= x8 y9))
          (or (not (= x8 y9)) (= y9 x9))
          (or (= x10 x11) (= x10 y11))
          (or (not (= x10 y11)) (= y11 x11))
          (or (= x12 x13) (= x12 y13))
          (or (not (= x12 y13)) (= y13 x13))
          (or (= x14 x15) (= x14 y15))
          (or (not (= x14 y15)) (= y15 x15))
          (or (= x16 x17) (= x16 y17))
          (or (not (= x16 y17)) (= y17 x17))
          (or (= x18 x19) (= x18 y19))
          (or (not (= x18 y19)) (= y19 x19))
          (or (= x20 x21) (= x20 y21))
          (or (not (= x20 y21)) (= y21 x21))
          (or (= x22 x23) (= x22 y23))
          (or (not (= x22 y23)) (= y23 x23))
        ))

(set-itp-group B)
(assert (and
          (or (= x1 x2) (= x1 y2))
          (or (not (= x1 y2)) (= y2 x2))
          (or (= x3 x4) (= x3 y4))
          (or (not (= x3 y4)) (= y4 x4))
          (or (= x5 x6) (= x5 y6))
          (or (not (= x5 y6)) (= y6 x6))
          (or (= x7 x8) (= x7 y8))
          (or (not (= x7 y8)) (= y8 x8))
          (or (= x9 x10) (= x9 y10))
          (or (not (= x9 y10)) (= y10 x10))
          (or (= x11 x12) (= x11 y12))
          (or (not (= x11 y12)) (= y12 x12))
          (or (= x13 x14) (= x13 y14))
          (or (not (= x13 y14)) (= y14 x14))
          (or (= x15 x16) (= x15 y16))
          (or (not (= x15 y16)) (= y16 x16))
          (or (= x17 x18) (= x17 y18))
          (or (not (= x17 y18)) (= y18 x18))
          (or (= x19 x20) (= x19 y20))
          (or (not (= x19 y20)) (= y20 x20))
          (or (= x21 x22) (= x21 y22))
          (or (not (= x21 y22)) (= y22 x22))
          (or (= x23 x24) (= x23 y24))
          (or (not (= x23 y24)) (= y24 x24))
          (not (= x0 x24))
        ))

(check-sat)
