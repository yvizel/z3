;; Everything at once. A-local F, G, K; shared H (H(b) = w is a B fact).
;;   run 1: u ~ F(G(x),p) =[HORN: nested G premise x=y, plus p=q]= F(t,q)
;;          ~ H(a) =[BOUNDARY: H shared]= H(b)     -- then a B edge to w
;;   run 2: w ~ K(c) =[HORN: c=d]= K(d) ~ v
;;   expected: (and (=> (and (= x y) (= p q)) (= u (H a)))
;;                  (=> (= c d) (= w v)))
(set-option :sat.euf true)
(set-option :tactic.default_tactic sat)
(set-option :solver.proof.log horn_kitchen_sink_proof.smt2)
(set-option :solver.proof.interpolate_log true)
(declare-sort U)
(declare-const x U) (declare-const y U) (declare-const p U) (declare-const q U)
(declare-const a U) (declare-const b U) (declare-const c U) (declare-const d U)
(declare-const t U) (declare-const w U) (declare-const u U) (declare-const v U)
(declare-fun F (U U) U) (declare-fun G (U) U) (declare-fun H (U) U) (declare-fun K (U) U)
(set-itp-group A)
(assert (= u (F (G x) p)))
(assert (= t (G y)))
(assert (= (F t q) (H a)))
(assert (= w (K c)))
(assert (= (K d) v))
(set-itp-group B)
(assert (= x y))
(assert (= p q))
(assert (= a b))
(assert (= (H b) w))
(assert (= c d))
(assert (not (= u v)))
(check-sat)
