;; Interpolation proof-reordering test (FMCAD'14 "DRUPing for Interpolants").
;;
;; Two implication chains over independent equality atoms, with color
;; pattern A A B repeating along each chain: consecutive A-steps form runs
;; that proof restructuring can factor into single-colored chains. An
;; A-clause case split (or e0 f0) seeds both chains; B refutes both ends.
;; Purely propositional over equality atoms - no EUF lemmas, no deletions -
;; so the trimmed proof replays exactly.
;;
;; Usage:
;;   z3 itp_reorder.smt2                # produces itp_reorder_proof.smt2
;;   z3 solver.proof.trim=true solver.proof.interpolate=true \
;;      solver.proof.check_interpolant=true [solver.proof.reorder=false] \
;;      -v:1 itp_reorder_proof.smt2
;;
;; With reorder=true (default) the raw interpolant is a flat CNF-like
;; conjunction with one small clause per color-run boundary; with
;; reorder=false it is a deeply nested and/or alternation of the same size.

(set-option :sat.euf true)
(set-option :tactic.default_tactic sat)
(set-option :solver.proof.log itp_reorder_proof.smt2)
(set-option :solver.proof.interpolate_log true)

