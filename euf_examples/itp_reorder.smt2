          (or (not (= fa11 fb11)) (= fa12 fb12))
          (or (not (= fa12 fb12)) (= fa13 fb13))
          (or (not (= fa14 fb14)) (= fa15 fb15))
          (or (not (= fa15 fb15)) (= fa16 fb16))
          (or (not (= fa17 fb17)) (= fa18 fb18))
          (or (not (= fa18 fb18)) (= fa19 fb19))
          (or (not (= fa20 fb20)) (= fa21 fb21))
          (or (not (= fa21 fb21)) (= fa22 fb22))
          (or (not (= fa23 fb23)) (= fa24 fb24))
          (or (not (= fa24 fb24)) (= fa25 fb25))
