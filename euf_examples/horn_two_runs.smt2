;; Two A-runs separated by a B link p = q, each through an A-local
;; congruence. Two Horn clauses, one per run.
;;   expected: (and (=> (= x y) (= u p)) (=> (= x2 y2) (= q v)))
(set-option :sat.euf true)
(set-option :tactic.default_tactic sat)
(set-option :solver.proof.log horn_two_runs_proof.smt2)
(set-option :solver.proof.interpolate_log true)
(declare-sort U)
(declare-const x U) (declare-const y U) (declare-const x2 U) (declare-const y2 U)
(declare-const p U) (declare-const q U) (declare-const u U) (declare-const v U)
(declare-fun F (U) U) (declare-fun G (U) U)
(set-itp-group A)
(assert (= u (F x)))
(assert (= (F y) p))
(assert (= q (G x2)))
(assert (= (G y2) v))
(set-itp-group B)
(assert (= x y))
(assert (= p q))
(assert (= x2 y2))
(assert (not (= u v)))
(check-sat)
