;; 6 parallel 3-step A/B equality ladders over disjoint variables;
;; B refutes the disjunction of the negated ladder conclusions, so every
;; ladder is in the core. Deep propositional resolution over many small
;; theory lemmas.

(set-option :sat.euf true)
(set-option :tactic.default_tactic sat)
(set-option :solver.proof.log wide6_proof.smt2)
(set-option :solver.proof.interpolate_log true)

(declare-sort U)
(declare-const x0_0 U)
(declare-const x0_1 U)
(declare-const x0_2 U)
(declare-const x0_3 U)
(declare-const y0_1 U)
(declare-const y0_2 U)
(declare-const y0_3 U)
(declare-const x1_0 U)
(declare-const x1_1 U)
(declare-const x1_2 U)
(declare-const x1_3 U)
(declare-const y1_1 U)
(declare-const y1_2 U)
(declare-const y1_3 U)
(declare-const x2_0 U)
(declare-const x2_1 U)
(declare-const x2_2 U)
(declare-const x2_3 U)
(declare-const y2_1 U)
(declare-const y2_2 U)
(declare-const y2_3 U)
(declare-const x3_0 U)
(declare-const x3_1 U)
(declare-const x3_2 U)
(declare-const x3_3 U)
(declare-const y3_1 U)
(declare-const y3_2 U)
(declare-const y3_3 U)
(declare-const x4_0 U)
(declare-const x4_1 U)
(declare-const x4_2 U)
(declare-const x4_3 U)
(declare-const y4_1 U)
(declare-const y4_2 U)
(declare-const y4_3 U)
(declare-const x5_0 U)
(declare-const x5_1 U)
(declare-const x5_2 U)
(declare-const x5_3 U)
(declare-const y5_1 U)
(declare-const y5_2 U)
(declare-const y5_3 U)

(set-itp-group A)
(assert (and
          (or (= x0_0 x0_1) (= x0_0 y0_1))
          (or (not (= x0_0 y0_1)) (= y0_1 x0_1))
          (or (= x0_2 x0_3) (= x0_2 y0_3))
          (or (not (= x0_2 y0_3)) (= y0_3 x0_3))
          (or (= x1_0 x1_1) (= x1_0 y1_1))
          (or (not (= x1_0 y1_1)) (= y1_1 x1_1))
          (or (= x1_2 x1_3) (= x1_2 y1_3))
          (or (not (= x1_2 y1_3)) (= y1_3 x1_3))
          (or (= x2_0 x2_1) (= x2_0 y2_1))
          (or (not (= x2_0 y2_1)) (= y2_1 x2_1))
          (or (= x2_2 x2_3) (= x2_2 y2_3))
          (or (not (= x2_2 y2_3)) (= y2_3 x2_3))
          (or (= x3_0 x3_1) (= x3_0 y3_1))
          (or (not (= x3_0 y3_1)) (= y3_1 x3_1))
          (or (= x3_2 x3_3) (= x3_2 y3_3))
          (or (not (= x3_2 y3_3)) (= y3_3 x3_3))
          (or (= x4_0 x4_1) (= x4_0 y4_1))
          (or (not (= x4_0 y4_1)) (= y4_1 x4_1))
          (or (= x4_2 x4_3) (= x4_2 y4_3))
          (or (not (= x4_2 y4_3)) (= y4_3 x4_3))
          (or (= x5_0 x5_1) (= x5_0 y5_1))
          (or (not (= x5_0 y5_1)) (= y5_1 x5_1))
          (or (= x5_2 x5_3) (= x5_2 y5_3))
          (or (not (= x5_2 y5_3)) (= y5_3 x5_3))
        ))

(set-itp-group B)
(assert (and
          (or (= x0_1 x0_2) (= x0_1 y0_2))
          (or (not (= x0_1 y0_2)) (= y0_2 x0_2))
          (or (= x1_1 x1_2) (= x1_1 y1_2))
          (or (not (= x1_1 y1_2)) (= y1_2 x1_2))
          (or (= x2_1 x2_2) (= x2_1 y2_2))
          (or (not (= x2_1 y2_2)) (= y2_2 x2_2))
          (or (= x3_1 x3_2) (= x3_1 y3_2))
          (or (not (= x3_1 y3_2)) (= y3_2 x3_2))
          (or (= x4_1 x4_2) (= x4_1 y4_2))
          (or (not (= x4_1 y4_2)) (= y4_2 x4_2))
          (or (= x5_1 x5_2) (= x5_1 y5_2))
          (or (not (= x5_1 y5_2)) (= y5_2 x5_2))
          (or (not (= x0_0 x0_3)) (not (= x1_0 x1_3)) (not (= x2_0 x2_3)) (not (= x3_0 x3_3)) (not (= x4_0 x4_3)) (not (= x5_0 x5_3)))
        ))

(check-sat)
